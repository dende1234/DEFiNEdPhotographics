---
interface Props {
  title: string;
  body: string;
  muted?: boolean;
}

const { title, body, muted = false } = Astro.props;
const paragraphs = body.split(/\n{2,}/).filter(Boolean);
---

<section class={muted ? 'bg-bg-muted' : 'bg-bg'}>
  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-16">
    <h2 class="font-heading text-3xl text-primary">{title}</h2>
    <div class="mt-4 space-y-4 text-text/90 leading-relaxed">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>
